<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="seleniumProject">
	<listeners>
		<listener
			class-name="com.sevenrmartsupermarket.listeners.ExtentReporter">
		</listener>
	</listeners>
	<test name="TestByGroup">
		<groups>
			<run>
				<include name="smoke"></include>
				<include name="regression"></include>
			</run>
		</groups>
		<classes>
			<class name="com.sevenrmartsupermarket.tests.LoginTest">
			</class>
			<class name="com.sevenrmartsupermarket.tests.DashBoardTest">
			</class>
		</classes>
	</test>
</suite>