<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="seleniumProject">
	<listeners>
		<listener
			class-name="com.sevenrmartsupermarket.listeners.ExtentReporter">
		</listener>
	</listeners>
	<test name="RunningInChrome">
	<parameter name="browser" value="chrome"></parameter>
		<classes>
			<class name="com.sevenrmartsupermarket.tests.LoginTest">
			</class>
		</classes>
	</test>
	<test name="RunningInEdge">
	<parameter name="browser" value="edge"></parameter>
		<classes>
			<class name="com.sevenrmartsupermarket.tests.LoginTest">
			</class>
		</classes>
	</test>
	<test name="RunningInFirefox">
	<parameter name="browser" value="firefox"></parameter>
		<classes>
			<class name="com.sevenrmartsupermarket.tests.LoginTest">
			</class>
		</classes>
	</test>
</suite>